# Environment Variables Template
# 
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git!
#
# Required for: Supabase connection, Keep-Alive system

# ============================================================================
# Supabase Configuration (Required)
# ============================================================================

# Your Supabase Project URL
# Find at: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Key (public, safe to expose in client)
# Find at: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Server-Only Secrets (Never expose to client!)
# ============================================================================

# Supabase Service Role Key (bypasses RLS - KEEP SECRET!)
# Find at: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CRON Secret for Keep-Alive endpoint protection
# Generate a random string: openssl rand -base64 32
# Must match the CRON_SECRET in GitHub Actions secrets
CRON_SECRET=your-random-secret-string-here
